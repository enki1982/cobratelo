echo "=== SERVICIOS AGENTE ==="
systemctl list-units | grep -i "ayuda\|cobrat\|agent"
echo ""
systemctl status ayuda-es-agent 2>/dev/null || echo "servicio ayuda-es-agent no existe"

echo ""
echo "=== CRONTAB ==="
crontab -l 2>/dev/null || echo "sin crontab"

echo ""
echo "=== ARCHIVOS EN /root/ayuda-es-agent ==="
ls -la /root/ayuda-es-agent/

echo ""
echo "=== BASE DE DATOS SQLite ==="
ls -la /root/ayuda-es-agent/*.db 2>/dev/null
python3 -c "
import sqlite3
con = sqlite3.connect('/root/ayuda-es-agent/ayudas.db')
cur = con.cursor()
tables = [t[0] for t in cur.execute(\"SELECT name FROM sqlite_master WHERE type='table'\").fetchall()]
print('Tablas:', tables)
for t in tables:
    n = cur.execute(f'SELECT COUNT(*) FROM {t}').fetchone()[0]
    print(f'  {t}: {n} filas')
try:
    rows = cur.execute('SELECT ccaa, COUNT(*) FROM ayudas GROUP BY ccaa ORDER BY COUNT(*) DESC').fetchall()
    print('Por CCAA:')
    for r in rows: print(f'  {r[0]}: {r[1]}')
    ultima = cur.execute('SELECT MAX(created_at) FROM ayudas').fetchone()[0]
    print('Ultima creada:', ultima)
except Exception as e:
    print('Error:', e)
con.close()
"
