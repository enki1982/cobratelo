echo "=== INSTALANDO bdns_agent.py ==="
echo "" | base64 -d > /root/ayuda-es-agent/bdns_agent.py
echo "Líneas: $(wc -l /root/ayuda-es-agent/bdns_agent.py)"

echo ""
echo "=== TEST RÁPIDO API BDNS (3 convocatorias personas físicas) ==="
cd /root/ayuda-es-agent
python3 -c "
import urllib.request, json
url = 'https://www.infosubvenciones.es/bdnstrans/GE/es/convocatorias?page=0&pageSize=3&tipoBeneficiario=1&order=fechaModificacion&direction=desc'
req = urllib.request.Request(url, headers={'Accept': 'application/json', 'User-Agent': 'cobratelo.es/1.0'})
r = urllib.request.urlopen(req, timeout=20)
data = json.loads(r.read())
print('Total convocatorias personas fisicas:', data.get('totalElements'))
print('Paginas totales:', data.get('totalPages'))
for c in data.get('content', [])[:3]:
    print('---')
    print('Titulo:', (c.get('descripcion') or c.get('titulo',''))[:80])
    print('Organismo:', (c.get('organoConvocante') or {}).get('descripcion',''))
    print('CCAA:', (c.get('comunidadAutonoma') or {}).get('descripcion', 'Estatal'))
    print('Estado:', c.get('estado'))
    print('URL:', c.get('sedeElectronica','')[:80])
"

echo ""
echo "=== CRONTAB ACTUAL ==="
crontab -l

echo ""
echo "=== AÑADIENDO CRON BDNS (lunes 4am) ==="
(crontab -l; echo "0 4 * * 1  cd /root/ayuda-es-agent && export $(grep -v '^#' .env | grep -v '^$' | xargs) && python3 bdns_agent.py >> /var/log/bdns-agent.log 2>&1") | crontab -
crontab -l
