echo "=== TODOS LOS PY DEL BOT ==="
find /opt/bot -name "*.py" 2>/dev/null | sort

echo ""
echo "=== GREP EN TODOS ==="
grep -rn "normalized_qty\|free_base\|step_size\|insufficient" /opt/bot/ 2>/dev/null | grep "\.py:" | grep -v ".pyc"

echo ""
echo "=== PROCESO ACTIVO ==="
ps aux | grep python | grep -v grep | head -5

echo ""
echo "=== SERVICIO ==="
systemctl is-active auto-trader-bot 2>/dev/null || systemctl is-active bot-binance 2>/dev/null || systemctl list-units | grep -i "bot\|trader"
