source /root/ayuda-es-agent/.env 2>/dev/null || true
SUPABASE_URL="https://pcuomumijpzgatpfgtyo.supabase.co"
KEY=$(grep -E "SUPABASE_SERVICE|SERVICE_ROLE|SUPABASE_KEY" /root/ayuda-es-agent/.env 2>/dev/null | head -1 | cut -d'=' -f2 | tr -d '"')
ANON=$(grep -E "ANON_KEY|SUPABASE_ANON" /root/ayuda-es-agent/.env 2>/dev/null | head -1 | cut -d'=' -f2 | tr -d '"')
echo "Keys found: SERVICE=${#KEY} ANON=${#ANON}"
curl -s "${SUPABASE_URL}/rest/v1/ayudas?nombre=ilike.*Giron*&select=id,nombre,ambito,comunidad_autonoma,organismo&limit=3" \
  -H "apikey: ${KEY:-$ANON}" \
  -H "Authorization: Bearer ${KEY:-$ANON}" | python3 -m json.tool 2>/dev/null || echo "No JSON"
