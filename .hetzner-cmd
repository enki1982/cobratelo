# Parchear agent.py — mejor extracción de JSON + backfill sin web_search
python3 << 'PYEOF'
import re

with open('/root/ayuda-es-agent/agent.py') as f:
    code = f.read()

# Fix 1: mejor extracción de texto de response.content (busca ÚLTIMO bloque text, logea si vacío)
old_parse = '''        texto = ""
        for bloque in response.content:
            if bloque.type == "text":
                texto = bloque.text
        if not texto.strip():
            log.warning(f"  Sin respuesta para {tema}")
            return []
        texto = texto.strip()
        if texto.startswith("```"):
            texto = texto.split("```")[1]
            if texto.startswith("json"):
                texto = texto[4:]
        if texto.endswith("```"):
            texto = texto.rsplit("```", 1)[0]
        datos = json.loads(texto.strip())'''

new_parse = '''        bloques_text = [b.text for b in response.content if hasattr(b, "type") and b.type == "text"]
        texto = bloques_text[-1] if bloques_text else ""
        if not texto.strip():
            log.warning(f"  Sin respuesta texto para {tema} (stop_reason={response.stop_reason})")
            return []
        m = re.search(r"\\{.*\\}", texto, re.DOTALL)
        if not m:
            log.warning(f"  Sin JSON en respuesta para {tema}")
            return []
        datos = json.loads(m.group(0))'''

if old_parse in code:
    code = code.replace(old_parse, new_parse)
    print("Fix 1 aplicado: extracción texto búsqueda")
else:
    print("Fix 1 NO encontrado — puede que ya esté parcheado")

# Fix 2: backfill sin web_search (usa conocimiento propio de Claude, más rápido y sin fallos)
old_backfill_call = '''            response = ai.messages.create(
                model="claude-haiku-4-5-20251001",
                max_tokens=1500,
                tools=[{"type": "web_search_20250305", "name": "web_search"}],
                messages=[{"role": "user", "content": prompt}]
            )
            texto = ""
            for bloque in response.content:
                if bloque.type == "text":
                    texto = bloque.text
            if not texto.strip():
                continue
            texto = texto.strip().lstrip("```json").lstrip("```").rstrip("```")
            datos = json.loads(texto.strip())'''

new_backfill_call = '''            response = ai.messages.create(
                model="claude-haiku-4-5-20251001",
                max_tokens=1500,
                messages=[{"role": "user", "content": prompt}]
            )
            bloques_text = [b.text for b in response.content if hasattr(b, "type") and b.type == "text"]
            texto = bloques_text[-1] if bloques_text else ""
            if not texto.strip():
                continue
            m = re.search(r"\\{.*\\}", texto, re.DOTALL)
            if not m:
                continue
            datos = json.loads(m.group(0))'''

if old_backfill_call in code:
    code = code.replace(old_backfill_call, new_backfill_call)
    print("Fix 2 aplicado: backfill sin web_search")
else:
    print("Fix 2 NO encontrado")

with open('/root/ayuda-es-agent/agent.py', 'w') as f:
    f.write(code)

print("Listo")
PYEOF

