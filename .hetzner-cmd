echo "=== CORRECCIÓN URL TARIFA PLANA ==="
python3 << 'PYEOF'
import os
from supabase import create_client
from dotenv import load_dotenv
load_dotenv('/root/ayuda-es-agent/.env')
sb = create_client(os.environ['SUPABASE_URL'], os.environ['SUPABASE_SERVICE_KEY'])
r = sb.table('ayudas').select('id,nombre').execute()
hits = [a for a in r.data if 'tarifa plana' in a['nombre'].lower() or 'tarifa_plana' in a['nombre'].lower()]
print(f"Ayudas tarifa plana encontradas: {len(hits)}")
for h in hits:
    sb.table('ayudas').update({'url_oficial': 'https://www.seg-social.es/wps/portal/wss/internet/Trabajadores/CotizacionRecaudacionTrabajadores/10721/10724'}).eq('id', h['id']).execute()
    print(f"  Actualizada: {h['nombre']}")
PYEOF

echo ""
echo "=== FIX PROMPT AGENTE ==="
echo "" | base64 -d > /tmp/fix_prompt.py && python3 /tmp/fix_prompt.py
