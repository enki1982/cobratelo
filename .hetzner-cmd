echo "PROC:"
ps aux | grep enricher | grep -v grep || true
echo "LOG:"
cat /tmp/enricher.log 2>/dev/null | head -20 || echo none
echo "ENV_CHECK:"
cd /root/ayuda-es-agent && source .env 2>/dev/null
python3 -c "import os; print('ANT', len(os.environ.get('ANTHROPIC_API_KEY','')), 'SB', len(os.environ.get('SUPABASE_SERVICE_KEY','')), 'FE', len(os.environ.get('FORWARD_EMAIL_API','')))" 2>&1
