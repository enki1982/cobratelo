cd /root/ayuda-es-agent
set -a; source .env; set +a

# Actualizar enricher
curl -s "https://raw.githubusercontent.com/enki1982/cobratelo/main/scripts/enricher.py" > /root/ayuda-es-agent/enricher.py

# Matar proceso anterior si existe
pkill -f "enricher.py" 2>/dev/null; sleep 2

# Lanzar en background
nohup python3 -u /root/ayuda-es-agent/enricher.py --all > /tmp/enricher.log 2>&1 &
echo "PID: $!"
disown

# Esperar 8s y verificar
sleep 8
echo "=== Proceso ==="
ps aux | grep "enricher" | grep -v grep && echo "CORRIENDO" || echo "NO_ENCONTRADO"
echo "=== Log inicial ==="
head -15 /tmp/enricher.log || true
