echo "=== Log enricher ==="
cat /tmp/enricher.log 2>/dev/null | tail -20 || echo "Sin log"
echo "=== Proceso activo ==="
pgrep -fa enricher || echo "No corre"
echo "=== FORWARD_EMAIL en .env ==="
grep -c FORWARD_EMAIL /root/ayuda-es-agent/.env 2>/dev/null || echo "No esta"
echo "=== Cron instalado ==="
crontab -l 2>/dev/null | grep enricher || echo "No hay cron"
