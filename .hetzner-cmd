# Escribir el script enriquecedor en el servidor
cat > /root/ayuda-es-agent/enricher.py << 'PYEOF'
#!/usr/bin/env python3
"""
enricher.py — Enriquece ayudas en Supabase con metadatos de IA
Ejecutar: python3 enricher.py [--batch 50] [--dry-run]
"""
import os, json, time, sys, argparse
from anthropic import Anthropic
from supabase import create_client

# Config
SUPABASE_URL = os.environ["SUPABASE_URL"]
SUPABASE_KEY = os.environ["SUPABASE_SERVICE_KEY"]
ANTHROPIC_KEY = os.environ["ANTHROPIC_API_KEY"]
BATCH_SIZE = 20
SLEEP_BETWEEN = 3  # segundos entre batches

client = Anthropic(api_key=ANTHROPIC_KEY)
sb = create_client(SUPABASE_URL, SUPABASE_KEY)

PROMPT_SYSTEM = """Eres un experto en subvenciones públicas españolas.
Analiza ayudas y extrae metadatos estructurados.
Responde SOLO con JSON válido, sin texto adicional."""

def analizar_ayuda(ayuda: dict) -> dict:
    nombre = ayuda.get("nombre", "")[:300]
    organismo = ayuda.get("organismo", "")[:200]
    descripcion = ayuda.get("descripcion", "")[:500]
    ambito = ayuda.get("ambito", "")
    ccaa = ayuda.get("comunidad_autonoma", "")

    prompt = f"""Analiza esta ayuda pública española y extrae metadatos.

AYUDA:
- Nombre: {nombre}
- Organismo: {organismo}
- Descripción: {descripcion}
- Ámbito: {ambito}
- CCAA: {ccaa}

Extrae y devuelve SOLO este JSON (sin markdown, sin explicaciones):
{{
  "es_nominativa": false,
  "entidades_geo": [],
  "tipo_beneficiario": [],
  "sectores": [],
  "renta_max": null,
  "edad_min": null,
  "edad_max": null
}}

INSTRUCCIONES:
- es_nominativa: true SOLO si la ayuda va dirigida a una persona/empresa CONCRETA por nombre propio (ej: "Subvención a Juan García", "Ayuda a Empresa XYZ S.L.")
- entidades_geo: lista de municipios, comarcas o provincias CONCRETAS mencionadas (NO incluir CCAA genéricas como "Cataluña", "España"). Ej: ["Bilbao", "Gironès", "A Coruña"]
- tipo_beneficiario: uno o más de: "autonomo", "empresa", "empleado", "desempleado", "pensionista", "estudiante", "persona_fisica", "entidad_publica", "ong". Si aplica a todos: ["cualquiera"]
- sectores: sectores económicos específicos (vacío [] si es general). Ej: ["agricultura"], ["hosteleria"], ["tecnologia"]
- renta_max: número entero en euros/año si hay límite de renta, null si no
- edad_min/edad_max: enteros si hay requisito de edad, null si no"""

    resp = client.messages.create(
        model="claude-haiku-4-5-20251001",
        max_tokens=400,
        system=PROMPT_SYSTEM,
        messages=[{"role": "user", "content": prompt}]
    )
    
    texto = resp.content[0].text.strip()
    # Limpiar posibles backticks
    if texto.startswith("```"):
        texto = texto.split("```")[1]
        if texto.startswith("json"):
            texto = texto[4:]
    
    return json.loads(texto.strip())

def procesar_batch(ayudas: list, dry_run: bool = False) -> int:
    ok = 0
    for ayuda in ayudas:
        try:
            meta = analizar_ayuda(ayuda)
            
            if dry_run:
                print(f"  [DRY] {ayuda['id'][:8]}... → nominativa={meta['es_nominativa']} geo={meta['entidades_geo']} bene={meta['tipo_beneficiario']}")
                ok += 1
                continue
            
            sb.table("ayudas").update({
                "es_nominativa": meta.get("es_nominativa", False),
                "entidades_geo": meta.get("entidades_geo", []),
                "tipo_beneficiario": meta.get("tipo_beneficiario", []),
                "sectores": meta.get("sectores", []),
                "renta_max": meta.get("renta_max"),
                "edad_min": meta.get("edad_min"),
                "edad_max": meta.get("edad_max"),
                "ia_analizada": True,
                "ia_analizada_at": "now()"
            }).eq("id", ayuda["id"]).execute()
            
            ok += 1
            print(f"  ✓ {ayuda['id'][:8]}... {ayuda.get('nombre','')[:60]}")
            
        except Exception as e:
            print(f"  ✗ {ayuda.get('id','?')[:8]}... ERROR: {e}")
    
    return ok

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--batch", type=int, default=200, help="Ayudas a procesar en esta ejecución")
    parser.add_argument("--dry-run", action="store_true", help="No escribir en BD")
    parser.add_argument("--reset", action="store_true", help="Reprocesar todo (ignorar ia_analizada)")
    args = parser.parse_args()

    print(f"🔍 Enricher iniciado — batch={args.batch}, dry_run={args.dry_run}, reset={args.reset}")
    
    # Contar pendientes
    if args.reset:
        total_q = sb.table("ayudas").select("id", count="exact").execute()
    else:
        total_q = sb.table("ayudas").select("id", count="exact").eq("ia_analizada", False).execute()
    
    total = total_q.count
    print(f"📊 Ayudas pendientes: {total}")
    
    procesadas = 0
    offset = 0
    
    while procesadas < args.batch:
        size = min(BATCH_SIZE, args.batch - procesadas)
        
        q = sb.table("ayudas").select("id,nombre,organismo,descripcion,ambito,comunidad_autonoma")
        if not args.reset:
            q = q.eq("ia_analizada", False)
        q = q.limit(size).offset(offset)
        
        result = q.execute()
        ayudas = result.data
        
        if not ayudas:
            print("✅ No hay más ayudas pendientes")
            break
        
        print(f"\n📦 Procesando batch {offset//BATCH_SIZE + 1} ({len(ayudas)} ayudas)...")
        ok = procesar_batch(ayudas, dry_run=args.dry_run)
        procesadas += ok
        
        print(f"   Batch: {ok}/{len(ayudas)} OK | Total: {procesadas}/{args.batch}")
        
        if len(ayudas) < size:
            break
        
        if procesadas < args.batch:
            print(f"   💤 Pausa {SLEEP_BETWEEN}s...")
            time.sleep(SLEEP_BETWEEN)
        
        if args.dry_run:
            offset += size
    
    print(f"\n🎉 Completado: {procesadas} ayudas enriquecidas")

if __name__ == "__main__":
    main()
PYEOF
echo "enricher.py creado"
python3 -c "import anthropic, supabase; print('deps OK')"
