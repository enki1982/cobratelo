cd /root/ayuda-es-agent && set -a && source .env && set +a && python3 -c "
from supabase import create_client
import os
sb = create_client(os.environ['SUPABASE_URL'], os.environ['SUPABASE_SERVICE_KEY'])

# Ver columnas actuales de perfiles
try:
    r = sb.table('perfiles').select('*').limit(1).execute()
    if r.data:
        print('Columnas:', list(r.data[0].keys()))
    else:
        print('Tabla perfiles vacía pero existe')
except Exception as e:
    print('Error:', e)
"
