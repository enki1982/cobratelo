cd /root/ayuda-es-agent
source .env
export SUPABASE_URL SUPABASE_SERVICE_KEY ANTHROPIC_API_KEY

# Estado proceso
pgrep -f enricher.py && echo "PROCESO ACTIVO" || echo "NO CORRE"

# Relanzar si no corre
pgrep -f enricher.py || nohup python3 -u enricher.py --batch 11000 >> /root/enricher.log 2>&1 &

sleep 3

# Log
tail -15 /root/enricher.log
