echo "=== DESCARGANDO bdns_agent.py desde GitHub ==="
curl -s -o /root/ayuda-es-agent/bdns_agent.py https://raw.githubusercontent.com/enki1982/cobratelo/main/bdns_agent.py
echo "Resultado curl: $?"
echo "Lineas: $(wc -l /root/ayuda-es-agent/bdns_agent.py)"

echo ""
echo "=== TEST API BDNS ==="
python3 /root/ayuda-es-agent/bdns_agent.py --test 2>/dev/null || python3 -c "
import urllib.request, json
url = 'https://www.infosubvenciones.es/bdnstrans/GE/es/convocatorias?page=0&pageSize=2&tipoBeneficiario=1'
r = urllib.request.urlopen(urllib.request.Request(url, headers={'Accept':'application/json','User-Agent':'cobratelo/1.0'}), timeout=20)
d = json.loads(r.read())
print('Total:', d.get('totalElements'))
print('Paginas:', d.get('totalPages'))
c = d.get('content',[])
for x in c[:2]:
    print('---')
    print((x.get('descripcion') or x.get('titulo',''))[:80])
    print((x.get('organoConvocante') or {}).get('descripcion',''))
"

echo ""
echo "=== CRON ==="
( crontab -l 2>/dev/null | grep -v bdns_agent ; echo "0 4 * * 1  cd /root/ayuda-es-agent && export \$(grep -v '^#' .env | xargs) && python3 bdns_agent.py >> /var/log/bdns-agent.log 2>&1" ) | crontab -
crontab -l | grep -E "bdns|agent"
