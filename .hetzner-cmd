cd /root/ayuda-es-agent || true
set -a; source .env 2>/dev/null; set +a

curl -s "https://raw.githubusercontent.com/enki1982/cobratelo/main/scripts/enricher.py" -o /root/ayuda-es-agent/enricher.py || true
pkill -f "enricher.py" 2>/dev/null || true
sleep 2

# Lanzar totalmente desconectado del shell
setsid nohup python3 -u /root/ayuda-es-agent/enricher.py --all </dev/null >/tmp/enricher.log 2>&1 &
echo "Lanzado PID: $!"
sleep 10

ps aux | grep "[e]nricher" | head -3 || true
echo "=== Log ==="
cat /tmp/enricher.log 2>/dev/null || true
echo "DONE"
