cd /root/ayuda-es-agent && source .env
export SUPABASE_URL SUPABASE_SERVICE_KEY ANTHROPIC_API_KEY

# Verificar si corre, si no → relanzar
if pgrep -f "enricher.py" > /dev/null 2>&1; then
    echo "YA CORRE PID=$(pgrep -f enricher.py)"
else
    echo "No corre, relanzando..."
    nohup python3 -u enricher.py --batch 11000 >> /root/enricher.log 2>&1 &
    echo "Lanzado PID=$!"
fi

sleep 5
echo "--- PROCESO ---"
ps aux | grep enricher | grep -v grep || echo "no encontrado"
echo "--- LOG ---"
tail -20 /root/enricher.log
