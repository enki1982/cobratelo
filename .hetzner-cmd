# Obtener la API key de Anthropic del agente
grep -r "ANTHROPIC_API_KEY\|anthropic_api_key" /root/ayuda-es-agent/.env 2>/dev/null
grep -r "ANTHROPIC_API_KEY\|anthropic_api_key" /root/ayuda-es-agent/agent.py 2>/dev/null | head -5
env | grep ANTHROPIC
cat /root/.bashrc | grep ANTHROPIC
cat /root/.profile | grep ANTHROPIC
cat /root/ayuda-es-agent/.env 2>/dev/null
