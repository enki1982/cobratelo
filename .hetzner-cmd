echo "" | base64 -d > /tmp/fix_execution.py
echo "=== Script decodificado ==="
head -5 /tmp/fix_execution.py
echo "=== Ejecutando fix ==="
python3 /tmp/fix_execution.py
echo "=== Verificando ==="
grep -n "FEE_ADJUST\|FIX fees" /opt/bot/auto_trader_bot_v1/core/execution.py | head -5
echo "=== Reiniciando bot ==="
systemctl restart auto-trader-bot.service
sleep 6
echo "=== Log post-restart ==="
journalctl -u auto-trader-bot.service --no-pager -n 15
