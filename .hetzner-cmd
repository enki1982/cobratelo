echo "=== ESTRUCTURA AGENTE ==="
ls -la /root/ayuda-es-agent/
echo ""
echo "=== PRIMERAS 60 LÍNEAS agent.py ==="
head -60 /root/ayuda-es-agent/agent.py
echo ""
echo "=== ARCHIVOS RELACIONADOS BDNS ==="
ls /root/ayuda-es-agent/*.py 2>/dev/null
echo ""
echo "=== TEST API BDNS ==="
python3 -c "
import urllib.request, json
url = 'https://www.infosubvenciones.es/bdnstrans/GE/es/convocatorias?page=0&pageSize=3&tipoBeneficiario=1'
req = urllib.request.Request(url, headers={'Accept': 'application/json', 'User-Agent': 'cobratelo.es/1.0'})
r = urllib.request.urlopen(req, timeout=15)
data = json.loads(r.read())
print('Status OK')
print('Total:', data.get('totalElements', '?'))
print('Primer resultado:')
conv = data.get('content', [])[0] if data.get('content') else {}
for k, v in list(conv.items())[:10]:
    print(f'  {k}: {v}')
"
