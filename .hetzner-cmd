BOT=/opt/bot/auto_trader_bot_v1/main.py

echo "=== BACKUP ==="
cp $BOT ${BOT}.bak.$(date +%Y%m%d_%H%M%S) && echo "OK"

echo ""
echo "=== normalized_qty / free_base en main.py ==="
grep -n "normalized_qty\|free_base\|input_qty\|step_size\|LOT_SIZE\|floor\|round" $BOT | head -50

echo ""
echo "=== FUNCIONES SELL/SUBMIT ==="
grep -n "def.*sell\|def.*close\|def.*submit\|def.*place\|def.*order\|def.*execute" $BOT -i | head -20

echo ""
echo "=== LÍNEAS ALREDEDOR DE normalized_qty ==="
python3 << 'PYEOF'
with open('/opt/bot/auto_trader_bot_v1/main.py') as f:
    lines = f.readlines()

keywords = ['normalized_qty', 'free_base', 'LOT_SIZE', 'step_size']
for i, line in enumerate(lines):
    if any(k in line for k in keywords):
        start = max(0, i-4)
        end = min(len(lines), i+5)
        print(f"--- Linea {i+1} ---")
        for j in range(start, end):
            prefix = ">>>" if j == i else "   "
            print(f"{prefix} {j+1}: {lines[j]}", end="")
        print()
PYEOF
